<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Not grantable to us (signature-level) and not checked by LocationManagerService either;
         the developer-options picker filters candidate apps by it, so it must be declared for the
         no-root tier to be selectable at all. -->
    <uses-permission android:name="android.permission.ACCESS_MOCK_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Replays the last injection after a reboot; the spec is stored by MockService on every
         start, so the receiver itself only decides "restore or stay quiet". -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- The policy page lists the apps that ask for location; without this, Android 11+ package
         visibility hides all but a handful and the list is useless. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- MocklocTheme: DayNight + NoActionBar (res/values[-night]/themes.xml). The old hardcoded
         Light theme printed the title twice; DayNight keeps the pages readable at night. -->
    <application
        android:allowBackup="false"
        android:description="@string/module_desc"
        android:label="@string/app_name"
        android:theme="@style/MocklocTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- DUMP keeps this startable from adb/shell but not from ordinary third-party apps. -->
        <service
            android:name=".MockService"
            android:exported="true"
            android:foregroundServiceType="location"
            android:permission="android.permission.DUMP" />

        <!-- BOOT_COMPLETED is a protected broadcast: only the system can send it, so exported
             exposes no spoofable surface. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
