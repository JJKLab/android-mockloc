# Android shell scripts must stay LF: a CRLF service.sh dies with "bad interpreter"
# inside Magisk/KSU and the failure looks like a silent no-op.
* text=auto eol=lf
*.sh text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.prop text eol=lf
*.py text eol=lf
*.jar binary
